def print_rankings(rankings, title="POWER RANKINGS", show_breakdown=True):
    print(f"\n{'='*65}")
    print(f"  🏒  {title}")
    print(f"{'='*65}")
    print(f"{'Rank':<5} {'Team':<28} {'Rec':>7} {'Pts':>5} {'GD':>5} {'Score':>7}")
    print(f"{'-'*65}")

    for rank, (team, score, bd) in enumerate(rankings, 1):
        streak_type, streak_count = team.current_streak
        streak_str = f"{streak_type}{streak_count}" if streak_count > 0 else "-"
        gd = team.goal_diff
        gd_str = f"+{gd}" if gd > 0 else str(gd)

        print(f"#{rank:<4} {team.name:<28} {team.record_str():>7} {team.points:>5} {gd_str:>5} {score:>7.4f}")

        if show_breakdown:
            print(f"       {'PPG':>6} {'GD':>6} {'Recent':>8} {'Streak':>8} {'Forfeit':>9}")
            print(f"       {bd['ppg']:>6.3f} {bd['goal_diff']:>6.3f} {bd['recent_form']:>8.3f} {bd['streak']:>8.3f} {bd['forfeit']:>9.3f}")
            if team.forfeits_given > 0:
                print(f"       ⚠️  Forfeits given: {team.forfeits_given}")
            print()

    print(f"{'='*65}\n")


def print_movement(season_rankings, weekly_rankings):
    """Shows how each team's weekly rank compares to season rank."""
    season_ranks = {t.name: i+1 for i, (t, _, _) in enumerate(season_rankings)}
    weekly_ranks = {t.name: i+1 for i, (t, _, _) in enumerate(weekly_rankings)}

    print(f"\n{'='*65}")
    print(f"  📊  WEEKLY vs SEASON RANKING MOVEMENT")
    print(f"{'='*65}")
    print(f"{'Team':<28} {'Season Rank':>12} {'Week Rank':>11} {'Movement':>10}")
    print(f"{'-'*65}")

    # Sort by season rank
    for name in sorted(season_ranks, key=lambda n: season_ranks[n]):
        s_rank = season_ranks.get(name, 'N/A')
        w_rank = weekly_ranks.get(name, 'N/A')

        if isinstance(s_rank, int) and isinstance(w_rank, int):
            diff = s_rank - w_rank
            if diff > 0:
                move = f"▲ +{diff}"
            elif diff < 0:
                move = f"▼ {diff}"
            else:
                move = "  —"
        else:
            move = "N/A"

        print(f"{name:<28} #{str(s_rank):<11} #{str(w_rank):<10} {move:>10}")

    print(f"{'='*65}\n")


