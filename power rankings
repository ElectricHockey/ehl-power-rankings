# ============================================================
# NHL-STYLE POWER RANKINGS ENGINE
# For EHL (Electric Hockey League) Schedule
# ============================================================

# --- SCORING WEIGHTS (tweak these to adjust ranking feel) ---
WEIGHT_PPG          = 0.35   # Points Per Game (season)
WEIGHT_GOAL_DIFF    = 0.20   # Goal Differential Per Game
WEIGHT_RECENT_FORM  = 0.25   # Last 10 games performance
WEIGHT_WIN_STREAK   = 0.10   # Current win/loss streak
WEIGHT_FORFEIT_PEN  = 0.10   # Forfeit penalty factor

# Points system
WIN_PTS   = 2
OTL_PTS   = 1
LOSS_PTS  = 0

# ============================================================
# DATA STRUCTURES
# ============================================================

class Team:
    def __init__(self, name):
        self.name = name
        self.wins = 0
        self.losses = 0
        self.otl = 0           # Overtime losses
        self.goals_for = 0
        self.goals_against = 0
        self.forfeits_given = 0    # Times THEY forfeited (penalized)
        self.forfeits_received = 0 # Times opponent forfeited (free win)
        self.game_log = []         # List of results in order: 'W','L','OTL'
        self.points_log = []       # Points earned each game in order

    @property
    def games_played(self):
        return self.wins + self.losses + self.otl

    @property
    def points(self):
        return (self.wins * WIN_PTS) + (self.otl * OTL_PTS)

    @property
    def ppg(self):
        return self.points / self.games_played if self.games_played > 0 else 0

    @property
    def goal_diff(self):
        return self.goals_for - self.goals_against

    @property
    def goal_diff_per_game(self):
        return self.goal_diff / self.games_played if self.games_played > 0 else 0

    @property
    def recent_form(self):
        """Points earned in last 10 games, normalized 0-1 (max = 20 pts)"""
        last10 = self.points_log[-10:]
        if not last10:
            return 0
        return sum(last10) / (WIN_PTS * len(last10))

    @property
    def current_streak(self):
        """Returns (streak_type, count) e.g. ('W', 3) or ('L', 2)"""
        if not self.game_log:
            return ('None', 0)
        streak_type = self.game_log[-1]
        count = 0
        for result in reversed(self.game_log):
            if result == streak_type:
                count += 1
            else:
                break
        return (streak_type, count)

    @property
    def streak_score(self):
        """Win streak = positive bonus, loss streak = negative penalty, normalized"""
        stype, count = self.current_streak
        if stype == 'W':
            return min(count / 10.0, 1.0)   # Cap at 10-game streak
        elif stype == 'L':
            return max(-count / 10.0, -1.0)
        return 0.0

    @property
    def forfeit_penalty(self):
        """Penalize teams that forfeit. Returns a 0-1 scale (1 = no forfeits)"""
        if self.games_played == 0:
            return 1.0
        penalty = self.forfeits_given / self.games_played
        return max(0.0, 1.0 - penalty)

    def record_str(self):
        return f"{self.wins}-{self.losses}-{self.otl}"


# ============================================================
# CSV PARSER
# ============================================================

def _looks_like_game_row(first_cell):
    """Return True when the first schedule cell looks like a game row."""
    val = (first_cell or '').strip()
    if not val:
        return False
    # Examples:
    # - "1"
    # - "1 8:00 PM"
    # - "24 9:15 PM"
    # - "001 - 9:00 PM"
    if re.match(r'^\d+$', val):
        return True
    if re.match(r'^\d+\s+\d{1,2}:\d{2}(?:\s*[AP]M)?$', val, re.IGNORECASE):
        return True
    if re.match(r'^\d+\s*-\s*\d{1,2}:\d{2}(?:\s*[AP]M)?$', val, re.IGNORECASE):
        return True
    return False


def _parse_score_cell(raw):
    """Parse a score cell to int while rejecting non-integer numeric values."""
    value = float(raw)
    if not math.isfinite(value):
        raise ValueError("score is not finite")
    rounded = round(value)
    if abs(value - rounded) > 1e-9:
        raise ValueError("score is not an integer value")
    return int(rounded)


def parse_schedule(csv_text):
    """
    Parses the EHL schedule CSV and returns a dict of Team objects.
    Only processes Completed and Forfeit games (not Incomplete/In Progress).
    """
    teams = {}

    def get_team(name):
        name = name.strip()
        if name not in teams:
            teams[name] = Team(name)
        return teams[name]

    def _clean_header(text):
        return re.sub(r'[^a-z0-9]+', ' ', str(text or '').strip().lower()).strip()

    def _get_cell(row, idx):
        if idx is None or idx < 0 or idx >= len(row):
            return ''
        return row[idx].strip()

    def _infer_columns(row, current):
        """Infer column positions from a header row when present."""
        inferred = dict(current)
        found = set()

        for i, cell in enumerate(row):
            c = _clean_header(cell)
            if not c:
                continue

            # Scores before team-name checks to avoid collisions ("home score")
            if 'home' in c and ('score' in c or 'goal' in c):
                inferred['home_score'] = i
                found.add('home_score')
                continue
            if 'away' in c and ('score' in c or 'goal' in c):
                inferred['away_score'] = i
                found.add('away_score')
                continue

            if (
                c in ('#', 'game', 'game #', 'game number', 'game num', 'match')
                or c.startswith('game ')
                or ('game' in c and ('time' in c or 'number' in c or 'num' in c))
            ):
                inferred['game'] = i
                found.add('game')
                continue
            if 'home' in c and 'team' in c:
                inferred['home_name'] = i
                found.add('home_name')
                continue
            if 'away' in c and 'team' in c:
                inferred['away_name'] = i
                found.add('away_name')
                continue
            if c == 'home':
                inferred['home_name'] = i
                found.add('home_name')
                continue
            if c == 'away':
                inferred['away_name'] = i
                found.add('away_name')
                continue
            if c in ('ot', 'overtime'):
                inferred['ot'] = i
                found.add('ot')
                continue
            if 'status' in c or c in ('result', 'results'):
                inferred['status'] = i
                found.add('status')
                continue

        is_header = (
            ('home_name' in found and 'away_name' in found)
            and ('home_score' in found or 'away_score' in found or 'status' in found or 'game' in found)
        )
        return inferred, is_header

    # Default mapping for existing CSV layout
    col_idx = {
        'game': 0,
        'home_name': 1,
        'home_score': 2,
        'ot': 3,
        'away_score': 4,
        'away_name': 5,
        'status': 7,
    }

    lines = csv_text.strip().split('\n')
    reader = csv.reader(lines)

    for row in reader:
        if not row:
            continue

        # Update column indices only when a header row is detected.
        # Applying the result for every row (not just headers) can
        # accidentally remap columns when game-data cells happen to
        # match a header keyword (e.g. the literal "OT" in an OT game
        # row would re-assign col_idx['ot'] mid-schedule).
        new_col_idx, is_header = _infer_columns(row, col_idx)
        if is_header:
            col_idx = new_col_idx
            continue

        # Find first non-empty cell to detect game/date rows robustly.
        first_non_empty = ''
        for cell in row:
            val = (cell or '').strip()
            if val:
                first_non_empty = val
                break
        if not first_non_empty:
            continue

        home_name = _get_cell(row, col_idx['home_name'])
        away_name = _get_cell(row, col_idx['away_name'])
        home_score_raw = _get_cell(row, col_idx['home_score'])
        away_score_raw = _get_cell(row, col_idx['away_score'])
        status = _get_cell(row, col_idx['status'])

        # Primary row detection:
        # 1) classic game-number row OR
        # 2) schedules without game-number column but with teams + scores present.
        game_cell = _get_cell(row, col_idx['game'])
        has_game_marker = (
            _looks_like_game_row(game_cell) or _looks_like_game_row(first_non_empty)
        )
        has_core_game_fields = bool(home_name and away_name and home_score_raw and away_score_raw)
        if not has_game_marker and not has_core_game_fields:
            continue

        status_norm = status.lower()

        # Skip if team names are missing
        if not home_name or not away_name:
            continue

        home_team = get_team(home_name)
        away_team = get_team(away_name)

        # Check OT marker column (if present).
        # Accept "OT", "OTW", "OT WIN", "YES", "Y", "1" as overtime
        # indicators so that different export formats are handled.
        is_ot = False
        middle = _get_cell(row, col_idx['ot'])
        middle_up = middle.strip().upper()
        if middle_up in ('OT', 'OTW', 'OT WIN', 'OVERTIME', 'YES', 'Y', '1'):
            is_ot = True

        try:
            home_score = _parse_score_cell(home_score_raw)
            away_score = _parse_score_cell(away_score_raw)
        except (ValueError, OverflowError):
            continue

        # Normalize status values for different export layouts.
        # Accept exact matches and also prefix-based variants such as
        # "Final/OT", "Final OT", "Completed OT", and bare "OT".
        _status_is_completed = (
            status_norm in ('', 'ot')
            or status_norm.startswith('final')
            or status_norm.startswith('complet')
        )
        if _status_is_completed:
            normalized_status = 'completed'
            # Layouts that put "Final/OT" or "Final OT" in the status
            # column signal overtime; mark is_ot here if the OT column
            # did not already do so.
            if 'ot' in status_norm:
                is_ot = True
        elif status_norm in ('forfeit', 'forfeited'):
            normalized_status = 'forfeit'
        elif status_norm in ('incomplete', 'in progress', 'scheduled', 'postponed'):
            continue
        else:
            # Unknown status strings are ignored.
            continue

        # ---- FORFEIT HANDLING ----
        if normalized_status == 'forfeit':
            # In your data: the loser forfeited.
            # Score of 1-0 means the team with 0 forfeited.
            if home_score > away_score:
                # Away team forfeited
                away_team.forfeits_given += 1
                home_team.forfeits_received += 1
                home_team.wins += 1
                home_team.game_log.append('W')
                home_team.points_log.append(WIN_PTS)
                away_team.losses += 1
                away_team.game_log.append('L')
                away_team.points_log.append(LOSS_PTS)
            else:
                # Home team forfeited
                home_team.forfeits_given += 1
                away_team.forfeits_received += 1
                away_team.wins += 1
                away_team.game_log.append('W')
                away_team.points_log.append(WIN_PTS)
                home_team.losses += 1
                home_team.game_log.append('L')
                home_team.points_log.append(LOSS_PTS)
            # Goals NOT counted for forfeits (don't reward/penalize GD on forfeits)

        # ---- COMPLETED GAME HANDLING ----
        elif normalized_status == 'completed':
            home_team.goals_for     += home_score
            home_team.goals_against += away_score
            away_team.goals_for     += away_score
            away_team.goals_against += home_score

            if home_score > away_score:
                if is_ot:
                    # OT win for home = regulation loss for away (OTL)
                    home_team.wins += 1
                    home_team.game_log.append('W')
                    home_team.points_log.append(WIN_PTS)
                    away_team.otl += 1
                    away_team.game_log.append('OTL')
                    away_team.points_log.append(OTL_PTS)
                else:
                    home_team.wins += 1
                    home_team.game_log.append('W')
                    home_team.points_log.append(WIN_PTS)
                    away_team.losses += 1
                    away_team.game_log.append('L')
                    away_team.points_log.append(LOSS_PTS)
            else:
                if is_ot:
                    away_team.wins += 1
                    away_team.game_log.append('W')
                    away_team.points_log.append(WIN_PTS)
                    home_team.otl += 1
                    home_team.game_log.append('OTL')
                    home_team.points_log.append(OTL_PTS)
                else:
                    away_team.wins += 1
                    away_team.game_log.append('W')
                    away_team.points_log.append(WIN_PTS)
                    home_team.losses += 1
                    home_team.game_log.append('L')
                    home_team.points_log.append(LOSS_PTS)

    return teams


# ============================================================
# NORMALIZATION
# ============================================================

def normalize(value, min_val, max_val):
    """Min-max normalization to 0-1 scale."""
    if max_val == min_val:
        return 0.5  # All teams equal on this metric
    return (value - min_val) / (max_val - min_val)


# ============================================================
# POWER SCORE CALCULATOR
# ============================================================

def calculate_power_scores(teams):
    """
    Calculates a composite power score for each team.
    Returns a list of (team, score, breakdown) tuples sorted best to worst.
    """
    team_list = [t for t in teams.values() if t.games_played > 0]

    if not team_list:
        return []

    # --- Gather raw values ---
    ppg_vals        = [t.ppg for t in team_list]
    gd_vals         = [t.goal_diff_per_game for t in team_list]
    recent_vals     = [t.recent_form for t in team_list]
    streak_vals     = [t.streak_score for t in team_list]
    forfeit_vals    = [t.forfeit_penalty for t in team_list]

    # --- Min/Max for normalization ---
    def mn(lst): return min(lst)
    def mx(lst): return max(lst)

    results = []
    for t in team_list:
        norm_ppg        = normalize(t.ppg,                mn(ppg_vals),     mx(ppg_vals))
        norm_gd         = normalize(t.goal_diff_per_game, mn(gd_vals),      mx(gd_vals))
        norm_recent     = t.recent_form   # Already 0-1
        norm_streak     = (t.streak_score + 1) / 2  # Convert -1..1 to 0..1
        norm_forfeit    = t.forfeit_penalty           # Already 0-1

        score = (
            norm_ppg     * WEIGHT_PPG        +
            norm_gd      * WEIGHT_GOAL_DIFF  +
            norm_recent  * WEIGHT_RECENT_FORM +
            norm_streak  * WEIGHT_WIN_STREAK  +
            norm_forfeit * WEIGHT_FORFEIT_PEN
        )

        breakdown = {
            'ppg':          round(norm_ppg, 3),
            'goal_diff':    round(norm_gd, 3),
            'recent_form':  round(norm_recent, 3),
            'streak':       round(norm_streak, 3),
            'forfeit':      round(norm_forfeit, 3),
        }
        results.append((t, round(score, 4), breakdown))

    # Sort by score descending
    results.sort(key=lambda x: x[1], reverse=True)
    return results


# ============================================================
# WEEKLY RANKINGS (last 7 days of completed games)
# ============================================================

def calculate_weekly_scores(teams_weekly):
    """Same as power scores but for a subset of games (weekly)."""
    return calculate_power_scores(teams_weekly)


