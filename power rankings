def print_rankings(rankings, title="POWER RANKINGS", show_breakdown=True):
    print(f"\n{'='*65}")
    print(f"  🏒  {title}")
    print(f"{'='*65}")
    print(f"{'Rank':<5} {'Team':<28} {'Rec':>7} {'Pts':>5} {'GD':>5} {'Score':>7}")
    print(f"{'-'*65}")

    for rank, (team, score, bd) in enumerate(rankings, 1):
        streak_type, streak_count = team.current_streak
        streak_str = f"{streak_type}{streak_count}" if streak_count > 0 else "-"
        gd = team.goal_diff
        gd_str = f"+{gd}" if gd > 0 else str(gd)

        print(f"#{rank:<4} {team.name:<28} {team.record_str():>7} {team.points:>5} {gd_str:>5} {score:>7.4f}")

        if show_breakdown:
            print(f"       {'PPG':>6} {'GD':>6} {'Recent':>8} {'Streak':>8} {'Forfeit':>9}")
            print(f"       {bd['ppg']:>6.3f} {bd['goal_diff']:>6.3f} {bd['recent_form']:>8.3f} {bd['streak']:>8.3f} {bd['forfeit']:>9.3f}")
            if team.forfeits_given > 0:
                print(f"       ⚠️  Forfeits given: {team.forfeits_given}")
            print()

    print(f"{'='*65}\n")


def print_movement(season_rankings, weekly_rankings):
    """Shows how each team's weekly rank compares to season rank."""
    season_ranks = {t.name: i+1 for i, (t, _, _) in enumerate(season_rankings)}
    weekly_ranks = {t.name: i+1 for i, (t, _, _) in enumerate(weekly_rankings)}

    print(f"\n{'='*65}")
    print(f"  📊  WEEKLY vs SEASON RANKING MOVEMENT")
    print(f"{'='*65}")
    print(f"{'Team':<28} {'Season Rank':>12} {'Week Rank':>11} {'Movement':>10}")
    print(f"{'-'*65}")

    # Sort by season rank
    for name in sorted(season_ranks, key=lambda n: season_ranks[n]):
        s_rank = season_ranks.get(name, 'N/A')
        w_rank = weekly_ranks.get(name, 'N/A')

        if isinstance(s_rank, int) and isinstance(w_rank, int):
            diff = s_rank - w_rank
            if diff > 0:
                move = f"▲ +{diff}"
            elif diff < 0:
                move = f"▼ {diff}"
            else:
                move = "  —"
        else:
            move = "N/A"

        print(f"{name:<28} #{str(s_rank):<11} #{str(w_rank):<10} {move:>10}")

    print(f"{'='*65}\n")


# ============================================================
# WEEK HELPERS
# ============================================================

_DAY_NAMES = frozenset({
    'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday',
})
_MONTH_NAMES = frozenset({
    'january', 'february', 'march', 'april', 'may', 'june',
    'july', 'august', 'september', 'october', 'november', 'december',
})
_DATE_WORDS = _DAY_NAMES | _MONTH_NAMES


def _looks_like_date(text):
    """Return True if *text* contains a recognisable day-of-week or month name."""
    words = set(re.split(r'[\s,/\-]+', text.lower().strip()))
    return bool(words & _DATE_WORDS)


def _looks_like_numeric_date(text):
    """Return True if *text* looks like a numeric date (e.g. ``1/4/2025``, ``01-04-25``)."""
    return bool(re.match(r'^\d{1,2}[/\-\.]\d{1,2}[/\-\.]\d{2,4}$', text.strip()))


def _any_cell_looks_like_date(row):
    """Return True if ANY cell in *row* contains a recognisable date string."""
    for cell in row:
        val = cell.strip() if cell else ''
        if not val:
            continue
        if _looks_like_date(val):
            return True
        if _looks_like_numeric_date(val):
            return True
    return False


def _find_date_row_indices(csv_text):
    """Find the line indices of week-boundary rows in the CSV text.

    A week-boundary row is any row that is **not** a game row and **not** a
    recognised column-header row.  Game rows are identified by their first
    cell matching the pattern ``digits + space`` (e.g. ``1 8:00 PM``,
    ``24 9:15 PM``).  This approach works regardless of the date format used
    in the schedule (text dates, numeric dates, datetime objects, etc.).
    """
    lines = csv_text.strip().split('\n')
    indices = []
    for i, line in enumerate(lines):
        stripped = line.strip()
        if not stripped:
            continue

        try:
            row = next(csv.reader([stripped]))
        except (StopIteration, csv.Error):
            continue
        if not row:
            continue

        # Check every cell — find the first non-empty one
        first_non_empty = ''
        for cell in row:
            val = cell.strip() if cell else ''
            if val:
                first_non_empty = val
                break

        if not first_non_empty:
            continue  # completely empty row

        # Game rows: first non-empty cell starts with digits + space (game # + time)
        # e.g. "1 8:00 PM", "24 9:15 PM", "100 7:00 PM"
        if re.match(r'^\d+\s', first_non_empty):
            continue

        # Column-header rows (skip the table header, not a week boundary)
        lower_val = first_non_empty.lower()
        if lower_val in ('#', 'game', 'game#', 'game #', 'date', 'home', 'away'):
            continue
        if lower_val.startswith('date') and len(lower_val) < 10:
            continue
        if lower_val.startswith('game') and len(lower_val) < 10:
            continue

        # Everything else is a week boundary (date row, section header, etc.)
        indices.append(i)
    return indices


def count_weeks(csv_text):
    """Count the number of date-section (week) boundaries in the schedule."""
    return len(_find_date_row_indices(csv_text))


def schedule_up_to_week(csv_text, max_week):
    """Return CSV text containing only games from weeks 1 through *max_week*.

    Each date-header row in the schedule is treated as the start of a new
    week.  Week 1 = first date section, week 2 = first two sections, etc.
    If *max_week* >= total weeks, all games are included.
    """
    lines = csv_text.strip().split('\n')
    date_indices = _find_date_row_indices(csv_text)

    if not date_indices or max_week < 1:
        return csv_text

    max_week = min(max_week, len(date_indices))
    if max_week < len(date_indices):
        end_idx = date_indices[max_week]
    else:
        end_idx = len(lines)

    return '\n'.join(lines[:end_idx])


def compute_movement(csv_text, target_week):
    """Compare rankings through *target_week* vs *target_week - 1*.

    Returns a dict ``{team_name: int}`` where a positive value means
    the team moved **up** (e.g. +2 = rose two spots) and negative means
    they moved **down**.  Teams new this week get ``None``.
    Returns an empty dict when there is no previous week.
    """
    if target_week <= 1:
        return {}

    current_csv = schedule_up_to_week(csv_text, target_week)
    prev_csv = schedule_up_to_week(csv_text, target_week - 1)

    current_teams = parse_schedule(current_csv)
    current_rankings = calculate_power_scores(current_teams)

    prev_teams = parse_schedule(prev_csv)
    prev_rankings = calculate_power_scores(prev_teams)

    prev_ranks = {t.name: i + 1 for i, (t, _, _) in enumerate(prev_rankings)}

    movement = {}
    for i, (team, _score, _bd) in enumerate(current_rankings):
        curr_rank = i + 1
        prev_rank = prev_ranks.get(team.name)
        if prev_rank is not None:
            movement[team.name] = prev_rank - curr_rank  # positive = moved up
        else:
            movement[team.name] = None  # brand-new team
    return movement


# ============================================================
# XLSX HELPER
# ============================================================

def xlsx_to_csv_text(xlsx_path):
    """Read the first sheet of an .xlsx file and return CSV text.

    Requires *openpyxl* (listed in requirements.txt).

    Special handling:
    - datetime cells are converted to "DayName MonthName Day" format
      (e.g. ``Monday January 6``) so the week-detection regex works.
    - All other non-string values are converted to their ``str()``
      representation so the CSV parser sees text it can handle.
    """
    import openpyxl
    from io import StringIO
    import datetime as _dt

    wb = openpyxl.load_workbook(xlsx_path, read_only=True, data_only=True)
    ws = wb.active

    buf = StringIO()
    writer = csv.writer(buf)
    for row in ws.iter_rows(values_only=True):
        converted = []
        for c in row:
            if c is None:
                converted.append('')
            elif isinstance(c, _dt.datetime):
                # "Monday January 6" — matches the date-header regex
                converted.append(c.strftime("%A %B ") + str(c.day))
            elif isinstance(c, _dt.date):
                converted.append(c.strftime("%A %B ") + str(c.day))
            elif isinstance(c, (int, float)):
                # Excel often stores whole numbers as float; convert to int
                if isinstance(c, float) and c == int(c):
                    converted.append(str(int(c)))
                else:
                    converted.append(str(c))
            else:
                converted.append(str(c))
        writer.writerow(converted)
    wb.close()
    return buf.getvalue()


# ============================================================
# MAIN
# ============================================================

def run_rankings(csv_filepath):
    with open(csv_filepath, 'r', encoding='utf-8') as f:
        csv_text = f.read()

    # --- SEASON RANKINGS (all completed games) ---
    all_teams = parse_schedule(csv_text)
    season_rankings = calculate_power_scores(all_teams)

    print_rankings(season_rankings, title="SEASON POWER RANKINGS (All Games)")

    # --- WEEKLY RANKINGS (most recent week only) ---
    # Re-parse but only the last date block
    # Splits by date sections and takes the most recent completed week
    lines = csv_text.strip().split('\n')
    date_indices = []
    for i, line in enumerate(lines):
        if re.match(r'^"[A-Za-z]+ [A-Za-z]+ \d+', line) or re.match(r'^[A-Za-z]+ [A-Za-z]+ \d+', line):
            date_indices.append(i)

    if len(date_indices) >= 2:
        # Find the last week that has completed games
        for start_idx in reversed(range(len(date_indices))):
            start = date_indices[start_idx]
            end = date_indices[start_idx + 1] if start_idx + 1 < len(date_indices) else len(lines)
            week_chunk = '\n'.join(lines[:1] + lines[start:end])  # header + week

            week_teams = parse_schedule(week_chunk)
            if any(t.games_played > 0 for t in week_teams.values()):
                week_label = lines[start].strip().strip('"')
                weekly_rankings = calculate_power_scores(week_teams)
                print_rankings(weekly_rankings, title=f"WEEKLY POWER RANKINGS — {week_label}", show_breakdown=False)
                print_movement(season_rankings, weekly_rankings)
                break
    else:
        print("Only one week of data found — showing season rankings only.")


if __name__ == '__main__':
    import sys
    if len(sys.argv) < 2:
        print("Usage: python power_rankings.py 'schedule_report 2(Sheet1).csv'")
    else:
        run_rankings(sys.argv[1])
